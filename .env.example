# =============================================================================
# Yedid Smart Hub v2.0 — Plantilla de Configuración (.env.example)
# Copia este archivo a .env localmente. NUNCA subas el archivo .env a GitHub.
# =============================================================================

# Servidor Principal (FastAPI Loopback)
YEDID_HOST=127.0.0.1
YEDID_PORT=8765

# Motor LLM Local (Ollama)
YEDID_OLLAMA_URL=http://127.0.0.1:11434
YEDID_OLLAMA_MODEL=qwen3:8b

# Identidad del Propietario y Dominio Tailscale Serve (Opcional)
YEDID_OWNER_USER=jaime
YEDID_OWNER_EMAIL=owner@example.com
YEDID_TAILSCALE_DOMAIN=yedid-hub.tailnet.ts.net

# Dispositivos Locales
YEDID_TV_HOST=192.168.1.100

# Binarios de Agentes Locales (Opcional, usa %USERPROFILE% por defecto)
YEDID_AGY_BIN=%USERPROFILE%\Documents\Codex\AntigravityCLI\agy.exe
YEDID_PYTHON_BIN=python

# Tokens de Autenticación (En producción se almacenan en data/.token o Windows Credential Manager)
# YEDID_TOKEN=generado_automaticamente_en_data_.token
# GITHUB_TOKEN=configurado_en_windows_credential_manager
